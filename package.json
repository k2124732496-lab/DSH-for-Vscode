{
  "name": "dsh-for-vscode",
  "displayName": "DSH for VS Code",
  "description": "Use DeepSeek Harness (DSH) inside VS Code: the full DSH web GUI embedded in the sidebar, with server lifecycle management (auto-start, start/stop/restart, status bar).",
  "version": "0.2.0",
  "publisher": "KAZUHA",
  "license": "MIT",
  "icon": "media/ds.jpg",
  "galleryBanner": {
    "color": "#1d2354",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/k2124732496-lab/DSH-for-Vscode.git"
  },
  "homepage": "https://github.com/k2124732496-lab/DSH-for-Vscode",
  "bugs": {
    "url": "https://github.com/k2124732496-lab/DSH-for-Vscode/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "dsh",
    "deepseek",
    "harness",
    "ai",
    "agent",
    "coding-agent"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh",
          "title": "DSH",
          "icon": "media/dsh.svg",
          "when": "dsh.doesNotSupportSecondarySidebar"
        }
      ],
      "secondarySidebar": [
        {
          "id": "dshSecondary",
          "title": "DSH",
          "icon": "media/dsh.svg",
          "when": "!dsh.doesNotSupportSecondarySidebar"
        }
      ]
    },
    "views": {
      "dsh": [
        {
          "type": "webview",
          "id": "dsh.sidebarView",
          "name": "DSH",
          "icon": "media/dsh.svg",
          "when": "dsh.doesNotSupportSecondarySidebar"
        }
      ],
      "dshSecondary": [
        {
          "type": "webview",
          "id": "dsh.sidebarSecondaryView",
          "name": "DSH",
          "icon": "media/dsh.svg",
          "when": "!dsh.doesNotSupportSecondarySidebar"
        }
      ]
    },
    "commands": [
      {
        "command": "dsh.openPanel",
        "title": "DSH: Open Sidebar",
        "icon": {
          "light": "media/dsh.svg",
          "dark": "media/dsh.svg"
        }
      },
      {
        "command": "dsh.startServer",
        "title": "DSH: Start Server",
        "icon": "$(play)"
      },
      {
        "command": "dsh.stopServer",
        "title": "DSH: Stop Server",
        "icon": "$(debug-stop)"
      },
      {
        "command": "dsh.restartServer",
        "title": "DSH: Restart Server",
        "icon": "$(debug-restart)"
      },
      {
        "command": "dsh.openInBrowser",
        "title": "DSH: Open in Browser",
        "icon": "$(globe)"
      },
      {
        "command": "dsh.showLogs",
        "title": "DSH: Show Logs",
        "icon": "$(output)"
      },
      {
        "command": "dsh.pinCurrentFile",
        "title": "DSH: Pin Current File"
      },
      {
        "command": "dsh.unpinCurrentFile",
        "title": "DSH: Unpin Current File"
      },
      {
        "command": "dsh.manageContextFiles",
        "title": "DSH: Manage Context Files"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dsh.startServer",
          "when": "view == dsh.sidebarView && !dsh.running",
          "group": "navigation@1"
        },
        {
          "command": "dsh.restartServer",
          "when": "view == dsh.sidebarView && dsh.running",
          "group": "navigation@1"
        },
        {
          "command": "dsh.stopServer",
          "when": "view == dsh.sidebarView && dsh.running",
          "group": "navigation@2"
        },
        {
          "command": "dsh.openInBrowser",
          "when": "view == dsh.sidebarView && dsh.running",
          "group": "navigation@3"
        },
        {
          "command": "dsh.showLogs",
          "when": "view == dsh.sidebarView",
          "group": "navigation@9"
        },
        {
          "command": "dsh.startServer",
          "when": "view == dsh.sidebarSecondaryView && !dsh.running",
          "group": "navigation@1"
        },
        {
          "command": "dsh.restartServer",
          "when": "view == dsh.sidebarSecondaryView && dsh.running",
          "group": "navigation@1"
        },
        {
          "command": "dsh.stopServer",
          "when": "view == dsh.sidebarSecondaryView && dsh.running",
          "group": "navigation@2"
        },
        {
          "command": "dsh.openInBrowser",
          "when": "view == dsh.sidebarSecondaryView && dsh.running",
          "group": "navigation@3"
        },
        {
          "command": "dsh.showLogs",
          "when": "view == dsh.sidebarSecondaryView",
          "group": "navigation@9"
        }
      ],
      "editor/title": [
        {
          "command": "dsh.openPanel",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "DSH",
      "properties": {
        "dsh.executablePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `dsh` executable (or to `@deepseek-ai/dsh/lib/bin.js`, which is run with `node`). Empty means auto-detect: the global npm install, then `dsh` on PATH.",
          "scope": "machine"
        },
        "dsh.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Start the DSH web server automatically when a trusted local workspace folder is open. Disabled by default; opening the DSH panel still starts it on demand."
        },
        "dsh.port": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "description": "Port for the DSH web server. 0 lets the OS pick a free port. A fixed port lets the extension reuse an already-running DSH instance on it."
        },
        "dsh.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Loopback host for the DSH web server. Non-loopback hosts are intentionally not supported.",
          "enum": [
            "127.0.0.1",
            "localhost"
          ]
        },
        "dsh.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments forwarded to the DSH web app (e.g. --trusted-host).",
          "scope": "machine"
        },
        "dsh.extraEnv": {
          "type": "object",
          "default": {},
          "description": "Extra environment variables applied after inherited VS Code/Electron/Chrome variables are scrubbed. Explicit values here can restore or override those variables; only do so with trusted values.",
          "scope": "machine"
        },
        "dsh.dshHome": {
          "type": "string",
          "default": "",
          "description": "Custom DSH_HOME (profile/session/settings directory). Empty inherits the default (~/.dsh).",
          "scope": "machine"
        },
        "dsh.startupTimeoutSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 300,
          "description": "How long to wait for the web server to become reachable before reporting a failure."
        },
        "dsh.stopOnDeactivate": {
          "type": "boolean",
          "default": true,
          "description": "Stop the DSH server started by this extension when the extension deactivates (VS Code exit/reload)."
        },
        "dsh.autoRestart": {
          "type": "boolean",
          "default": false,
          "description": "Automatically restart the server after an unexpected crash."
        },
        "dsh.workspaceSync.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically select the DSH workspace and session that match the active local VS Code workspace folder. This is independent of editor context sharing."
        },
        "dsh.editorContext.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Share short-lived metadata for visible and pinned local files and Notebooks with DSH. Cell contents and file contents are never copied into the bridge file; enabling this restarts managed DSH."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "pretest": "npm run typecheck && node esbuild.mjs --test",
    "test": "node scripts/check-ui.mjs && node --test dist-test/config.test.js dist-test/discovery.test.js dist-test/editor-context.test.js dist-test/notebook-context.test.js dist-test/editor-context-bridge.test.js dist-test/editor-context-plugin.test.js dist-test/editor-context-vscode.test.js dist-test/workspace-sync-client.test.js dist-test/sidebar-placement.test.js dist-test/server.test.js dist-test/frame-proxy.test.js",
    "smoke": "npm run typecheck && node esbuild.mjs --smoke && node dist-smoke/smoke.js",
    "vscode:prepublish": "npm run build",
    "package": "npm run build && vsce package",
    "test:ui": "node scripts/check-ui.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "DSH starts a local process with workspace context and therefore requires Workspace Trust."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "DSH requires a local workspace directory for its process working directory."
    }
  }
}
